public class CuentaBancaria {
    String titular;
    double saldo;
    int numeroTransacciones = 0; 
    void consignar(double monto) {
        if (monto <= 0) {
            System.out.println("El monto a consignar debe ser mayor a cero.");
            return;
        }
        saldo += monto;
        numeroTransacciones++;
        System.out.println("Consignación exitosa en la cuenta de " + titular + ". Nuevo saldo: $" + saldo);
    }

    void retirar(double monto) {
        if (monto <= 0) {
            System.out.println("El monto a retirar debe ser mayor a cero.");
            return;
        }
        if (monto <= saldo) {
            saldo -= monto;
            numeroTransacciones++;
            System.out.println("Retiro exitoso de la cuenta de " + titular + ". Nuevo saldo: $" + saldo);
        } else {
            System.out.println("Fondos insuficientes en la cuenta de " + titular + ". Saldo actual: $" + saldo);
        }
    }

    void transferir(CuentaBancaria destino, double monto) {
        if (monto <= 0) {
            System.out.println("El monto a transferir debe ser mayor a cero.");
            return;
        }
        if (monto <= saldo) {
            this.retirar(monto);
            destino.consignar(monto);
            System.out.println("Transferencia realizada con éxito de " + this.titular + " a " + destino.titular);
        } else {
            System.out.println("Transferencia fallida: Fondos insuficientes en la cuenta de " + this.titular);
        }
    }

    double consultarSaldo() {
        return saldo;
    }
}


public class Producto {
    String nombre;
    double precio;
    int stock;

    void registrarVenta(int cantidad) {
        if (cantidad <= 0) {
            System.out.println("La cantidad a vender debe ser mayor a cero.");
            return;
        }
        if (cantidad <= stock) {
            stock -= cantidad;
            System.out.println("Venta realizada: " + cantidad + " unidad(es) de " + nombre + ".");
        } else {
            System.out.println("No hay suficientes unidades disponibles de " + nombre + ". Stock actual: " + stock);
        }
    }

    void reponer(int cantidad) {
        if (cantidad <= 0) {
            System.out.println("La cantidad a reponer debe ser mayor a cero.");
            return;
        }
        stock += cantidad;
        System.out.println("Stock repuesto. Nuevo stock de " + nombre + ": " + stock);
    }

 
    void mostrarInformacion() {
        System.out.println("Producto: " + nombre + " | Precio: $" + precio + " | Stock: " + stock);
    }
}


